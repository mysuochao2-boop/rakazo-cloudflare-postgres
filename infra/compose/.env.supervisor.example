# Hybrid VPS supervisor env template (tracked — placeholders only, never real values).
# Copy to `infra/compose/.env.supervisor` (git-ignored), fill with real values,
# and start with:
#   docker compose --env-file infra/compose/.env.supervisor \
#     -f infra/compose/docker-compose.supervisor-only.yml up -d --build
# Variables map 1:1 to infra/compose/docker-compose.supervisor-only.yml.
# Docs: docs/screen-direct.md, apps/cloudflare-edge/README.md + MIGRATION.md.

# REQUIRED. Dedicated 32+ char random secret (`openssl rand -hex 32`), distinct
# from BETTER_AUTH_SECRET / SCREEN_PROXY_SECRET / RAKAZO_UPDATER_TOKEN.
SANDBOX_SUPERVISOR_TOKEN=

# Computer image (keep app + computer on the same mirror when GHCR is unreachable).
RAKAZO_COMPUTER_IMAGE=rakazo/computer
RAKAZO_COMPUTER_IMAGE_TAG=local
# BUSYBOX_IMAGE=

# SANDBOX_HOME_MODE=local-key lets Cloudflare Containers provision without
# sharing DATA_DIR paths. Keep it unless you know why you are changing it.
SANDBOX_HOME_MODE=local-key
# published: Cloudflare edge reaches host-mapped noVNC via SCREEN_HOST/allowlist.
SANDBOX_SCREEN_NETWORK=published
SANDBOX_SCREEN_HOST=127.0.0.1
# Public URL base for /screen/<port>/ served through Nginx on this host
# (Docker HostIp stays 127.0.0.1). Example: https://computer.example.com
PUBLIC_SCREEN_BASE=

# RAKAZO_SCREEN_DIRECT (off unless the secret is set): same value as the API's
# RAKAZO_SCREEN_DIRECT_SECRET (32+ chars, distinct from SCREEN_PROXY_SECRET).
# Rollout order: supervisor first, then Nginx /direct/ block, then the API flag.
RAKAZO_SCREEN_DIRECT_SECRET=
RAKAZO_SCREEN_DIRECT_FRAME_ANCESTORS=
RAKAZO_SCREEN_DIRECT_ALLOWED_ORIGINS=

# Egress for local Docker computers. `restricted` needs
# infra/compose/restrict-computer-egress.sh on the host first.
SANDBOX_COMPUTER_EGRESS=restricted
# Idle sleep for computers (ms, min 30000; 0 disables). Default 0 keeps computers up.
SANDBOX_IDLE_MS=0

# Per-bot-computer ceilings (empty = defaults 2g / 2 CPUs / 2048 pids).
RAKAZO_COMPUTER_MEMORY=
RAKAZO_COMPUTER_CPUS=
RAKAZO_COMPUTER_PIDS_LIMIT=
SANDBOX_COMMAND_TIMEOUT_MS=300000
SANDBOX_TEAM_SCREEN_LIMIT=0
SANDBOX_MAX_COMPUTERS_PER_SPACE=0

# Display/observation tuning (empty = built-in defaults; see docs/computer-runtime.md).
RAKAZO_SCREEN_RESOLUTION=
RAKAZO_X11VNC_ARGS=
RAKAZO_SCREEN_VNC_QUALITY=
RAKAZO_SCREEN_VNC_COMPRESSION=
RAKAZO_OBSERVE_FORMAT=
RAKAZO_OBSERVE_JPEG_QUALITY=

# Loopback bind for the supervisor API; public access is via Nginx.
SUPERVISOR_HOST=127.0.0.1
LOG_LEVEL=info
