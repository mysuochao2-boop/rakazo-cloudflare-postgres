# RAKAZO_SCREEN_DIRECT: browser noVNC straight to the Docker supervisor host.
#
# NOT applied automatically. Add this `location` block inside the existing
# `server { server_name computer.51proxy.org; listen 443 ssl; ... }` block (e.g.
# /etc/nginx/conf.d/computer-51proxy.conf), next to the existing /screen/ location,
# then `sudo nginx -t && sudo systemctl reload nginx`.
#
# The supervisor (127.0.0.1:7091) validates the sealed capability in the path
# (AES-GCM, expiry, Origin allowlist, port owned by a managed computer) and proxies
# both the noVNC static files and the websocket to the computer's loopback port.
# Nginx only has to pass websocket upgrades through and keep the token out of logs.

# Already present in most configs (needed for $connection_upgrade):
# map $http_upgrade $connection_upgrade {
#   default upgrade;
#   ''      close;
# }

location ^~ /direct/ {
    # The capability token is in the path; do not write it to access logs.
    access_log off;

    proxy_pass http://127.0.0.1:7091;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Long-lived VNC streams; the supervisor closes them at capability expiry (1h).
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    proxy_request_buffering off;

    # Only GET/HEAD (static files + websocket upgrade) are meaningful here.
    limit_except GET HEAD { deny all; }
}
