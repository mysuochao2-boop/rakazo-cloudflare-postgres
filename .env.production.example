# Production single-VM Compose template (tracked — placeholders only, never real values).
# Copy to `.env` on the production host (git-ignored, read via
# `--env-file .env -f infra/compose/docker-compose.prod.yml`), fill every CHANGE_ME,
# and never commit the filled file.
# Docs: docs/self-host.md (Public single-VM deployment), docs/self-host-secrets.md.
# Preflight on the host: fill, then `docker compose --env-file .env
# -f infra/compose/docker-compose.prod.yml config --quiet`.

NODE_ENV=production
# Public hostname served by Caddy (also used to derive the default health check).
RAKAZO_HOST=app.example.com
BETTER_AUTH_URL=https://app.example.com
WEB_ORIGIN=https://app.example.com
API_URL=https://app.example.com

# --- Required secrets: independent random values, never reuse across keys ---
# openssl rand -hex 16   # POSTGRES_PASSWORD (URI-safe hex; no @ : / ? # %)
# openssl rand -hex 32   # each of the four below
POSTGRES_USER=rakazo
POSTGRES_PASSWORD=
POSTGRES_DB=rakazo
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
SCREEN_PROXY_SECRET=
# Distinct from the three above. Required by prod Compose for every provider.
SANDBOX_SUPERVISOR_TOKEN=
# Opt-in updater profile only (32+ chars, distinct from the four above).
# RAKAZO_UPDATER_TOKEN=
# RAKAZO_UPDATER_URL=

# --- Computers: E2B default keeps browser containers off the VM ---
# e2b | daytona | createos | box; overlay docker-compose.prod.docker.yml for local Docker.
SANDBOX_PROVIDER=e2b
# E2B_API_KEY=
# DAYTONA_API_KEY= (+DAYTONA_API_URL / DAYTONA_TARGET / DAYTONA_SNAPSHOT)
# BOX_API_KEY= (+BOX_API_URL)
# CREATEOS_SANDBOX_API_KEY= (+CREATEOS_SANDBOX_BASE_URL / _SHAPE / _ROOTFS)
AGENT_RUNTIME=pi
WAKEUP_DRIVER=graphile
DATA_DIR=/data

# Keep registration allowlisted while the service is private; empty preserves
# the stored allowlist, and a non-empty list is applied on every API start.
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=owner@example.com

# Deployment-wide fallback model (also connectable per-user in onboarding).
OPENROUTER_API_KEY=
# COMPOSIO_API_KEY=
# PIPEDREAM_CLIENT_ID= / PIPEDREAM_CLIENT_SECRET= / PIPEDREAM_PROJECT_ID= (+_ENVIRONMENT)

# Build-from-checkout defaults. Pin RAKAZO_IMAGE_TAG to a release tag once one
# is published; the updater moves the tag and RAKAZO_IMAGE_TAG_PREVIOUS rolls back.
RAKAZO_IMAGE=ghcr.io/elie222/rakazo/app
RAKAZO_IMAGE_TAG=local
# RAKAZO_DEPLOY_DIR=/srv/rakazo  (set explicitly when the checkout is elsewhere)
# RAKAZO_COMPOSE_FILE=infra/compose/docker-compose.prod.yml:ops/compose/overlay.yml
# RAKAZO_UPDATE_SERVICES=supervisor
# CADDYFILE_PATH=/etc/rakazo/Caddyfile.prod  (operator-owned override, e.g. Cloudflare allowlist)

# Transactional account email (Resend / SES / SMTP); blank disables.
SMTP_URL=
EMAIL_FROM=

# Usage metering / optional integrations.
# RAKAZO_AUTO_REVIEW_PROVIDER=jev
# TYPESAFE_API_KEY=

# Structured logs (JSON in production). Axiom needs both token and dataset.
LOG_LEVEL=info
LOG_FORMAT=
# AXIOM_TOKEN=
# AXIOM_DATASET=
# AXIOM_EDGE= / AXIOM_EDGE_URL=

# Optional OIDC SSO (mounts alongside password auth when all three are set).
# OIDC_ISSUER= / OIDC_CLIENT_ID= / OIDC_CLIENT_SECRET=
# OIDC_NAME=SSO / OIDC_SCOPES="openid email profile" / OIDC_ALLOW_SIGNUP_BYPASS=false

# Optional outbound proxy (Mainland / corporate). Include postgres/supervisor/api/worker/web in NO_PROXY.
# HTTP_PROXY= / HTTPS_PROXY= / NO_PROXY=localhost,127.0.0.1,postgres,supervisor,api,worker,web

# GIT_SHA is baked into published images; pass --build-arg GIT_SHA on manual
# builds so /internal/health reports the deployed revision.
# GIT_SHA=
